<!--<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.web>
		--><!-- 確保 IIS 能正確解析路徑中的中文字元 --><!--
		<globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
	</system.web>

	<system.webServer>
		<staticContent>
			--><!-- 移除並重新定義標準 WebGL 副檔名，確保伺服器允許傳輸 --><!--
			<remove fileExtension=".data" />
			<mimeMap fileExtension=".data" mimeType="application/octet-stream" />
			<remove fileExtension=".wasm" />
			<mimeMap fileExtension=".wasm" mimeType="application/wasm" />
			--><!-- 即使你目前沒用 .br，保留此項可增加未來相容性 --><!--
			<remove fileExtension=".br" />
			<mimeMap fileExtension=".br" mimeType="application/octet-stream" />
		</staticContent>

		--><!-- 關鍵：防止伺服器對已經壓縮過的 Unity 檔案進行二次 Gzip 壓縮 --><!--
		<urlCompression doStaticCompression="false" doDynamicCompression="false" />

		--><!-- 開啟目錄瀏覽，方便確認檔案路徑是否被正確讀取 --><!--
		<directoryBrowse enabled="true" />
	</system.webServer>
</configuration>-->
